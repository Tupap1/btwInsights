# Nombres de las variables que usa el proyecto. Solo nombres, sin valores. Nunca pegues valores en git ni en el chat.
#
# - .env.local: desarrollo (npm run db:subir, dev, importar, recolectar...). Lo crea npm run preparar-env.
# - .env.produccion: solo para docker-compose.prod.yml, en el servidor (ver docs/despliegue.md).
# - Ninguno de los dos va a git. Este archivo sí va a git (sin valores).

# Base de datos
# Desarrollo: Postgres de docker-compose.yml en 127.0.0.1. Para Neon, solo cambia DATABASE_URL (con sslmode=require).
DATABASE_URL=
# Opcional: URL del dueño para migrar. Si falta, npm run db:migrar usa DATABASE_URL.
DATABASE_URL_MIGRACIONES=
# Desarrollo: contraseña del dueño y puerto local del Postgres (por defecto 5434).
POSTGRES_PASSWORD=
POSTGRES_PUERTO=
# Producción: contraseñas de btw_app (la usa la app) y btw_lectura (solo lectura).
POSTGRES_APP_PASSWORD=
POSTGRES_LECTURA_PASSWORD=

# Importación inicial (npm run importar): carpeta de btw-videos, con publicar/ y el calendario.
BTW_VIDEOS_DIR=

# Meta (Facebook e Instagram). Token de la Página de BTW Inc (app btwoneinsights). Solo lectura.
META_PAGE_TOKEN=
META_PAGE_ID=
IG_USER_ID=
# Opcional: versión de la API de Graph (por defecto v25.0).
GRAPH_VERSION=

# Zernio (TikTok e Instagram). Solo lectura.
ZERNIO_API_KEY=

# Recolector: secreto del Bearer de POST /api/recolectar. Lo usan la app y el cron de producción.
RECOLECTOR_SECRETO=
# Solo producción: a dónde llama el cron. Opcional (por defecto http://app:3000/api/recolectar).
URL_RECOLECTAR=

# Inicio de sesión con llave de acceso (passkey). En producción son obligatorias: si falta una, nadie entra.
# Desarrollo usa localhost por defecto. Producción: insights.btw-one.com, https://insights.btw-one.com, BTW Insights.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGEN=
WEBAUTHN_RP_NOMBRE=

# Producción (docker-compose.prod.yml). Si se dejan vacías, el compose usa su valor por defecto.
# Red de Docker del proxy (Nginx Proxy Manager). Por defecto: proxy.
PROXY_RED=
# Etiqueta de las imágenes. Por defecto: local.
VERSION=
# Carpeta del servidor donde se copia cada respaldo. Por defecto: ./respaldos/produccion.
RESPALDO_HOST_DIR=
# uid:gid dueño de esas copias. Por defecto: root (ej. 1000:1000).
RESPALDO_HOST_PROPIETARIO=

# Pruebas (opcional): nombre de la base de pruebas. Sirve para correr dos pruebas en paralelo.
# Por defecto: btw_tablero_prueba.
BD_PRUEBA_NOMBRE=
