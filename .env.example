# Nombres de las variables (sin valores). Los valores los pone Andrés en .env.local, que no se sube a git. Nunca se
# pegan en el chat.

# Base de datos (Postgres en el PC; para pasar a la nube, solo cambia esta línea)
DATABASE_URL=

# Carpeta del archivo de videos (respaldada por Drive para escritorio de la cuenta personal)
ARCHIVO_DIR=

# Meta (token de Página de BTW Inc, app btwoneinsights)
META_PAGE_TOKEN=
META_PAGE_ID=
IG_USER_ID=
GRAPH_VERSION=v25.0

# Zernio (TikTok e Instagram)
ZERNIO_API_KEY=

# Acceso desde el celular (Cloudflare Tunnel + Access): para validar el JWT de Access
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Recolector
RECOLECTOR_SECRETO=
