{
  "name": "btw-tablero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verificar": "npm run typecheck && npm run lint && npm run test",
    "db:subir": "docker compose --env-file .env.local up -d db",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file=.env.local scripts/migrar.ts",
    "importar": "tsx --conditions=react-server --env-file=.env.local scripts/importar.ts",
    "recolectar": "tsx --conditions=react-server --env-file=.env.local scripts/recolectar.ts",
    "preparar-env": "node scripts/preparar-env.mjs",
    "grabar-fixtures": "tsx --env-file=.env.local scripts/grabar-fixtures.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "postgres": "4.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
